{
  "manifest_version": 3,
  "name": "Connect Flow",
  "short_name": "Connect Flow",
  "version": "2.0.0",
  "version_name": "2.0.0-beta",
  "description": "Connect AI coding agents to Google Flow with Nano Banana Pro, Veo 3.1 Fast, 30 character voices, and Direct Mode deterministic automation. No API keys.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "downloads",
    "tabs",
    "activeTab",
    "debugger"
  ],
  "host_permissions": [
    "*://flow.google.com/*",
    "*://labs.google/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "src/automation/selectors.js",
        "src/automation/driver.js",
        "src/automation/step-machine.js",
        "src/automation/agent-bridge.js",
        "src/automation/content.js",
        "assets/glacial-hud.js"
      ],
      "matches": [
        "*://flow.google.com/*",
        "*://labs.google/*"
      ],
      "run_at": "document_end"
    }
  ],
  "side_panel": {
    "default_path": "src/ui/side-panel/index.html"
  },
  "action": {
    "default_title": "Connect Flow V2 Beta",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "windows": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Open Connect Flow side panel"
    }
  },
  "web_accessible_resources": [
    {
      "matches": [
        "*://flow.google.com/*",
        "*://labs.google/*"
      ],
      "resources": [
        "icons/icon-16.png",
        "icons/icon-32.png",
        "icons/icon-48.png",
        "icons/icon-128.png",
        "assets/icon-16.png",
        "assets/icon-32.png",
        "assets/icon-48.png",
        "assets/icon-128.png",
        "assets/glacial-hud.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
